{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "api/*": ["./api/*"],
      "components/*": ["./components/*"],
      "context/*": ["./context/*"],
      "data/*": ["./data/*"],
      "hooks/*": ["./hooks/*"],
      "types/*": ["./types/*"],
      "utils/*": ["./utils/*"]
    },
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
